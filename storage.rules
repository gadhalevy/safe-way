rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /shelters/{imageId} {
      // Anyone can read shelter images (download URL includes token anyway)
      allow read: if true;
      // Anyone can upload (to allow unauthenticated shelter additions)
      allow write: if request.resource.size < 5 * 1024 * 1024  // max 5MB
        && request.resource.contentType.matches('image/.*');
    }
  }
}
