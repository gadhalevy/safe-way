# Path to your Firebase service account JSON key file
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json

# Firebase Storage bucket name (from Firebase Console → Storage)
STORAGE_BUCKET=safe-way-504b4.firebasestorage.app

# Allowed CORS origins (comma-separated, or * for all)
# Example: https://safe-way.vercel.app,http://localhost:3000
CORS_ORIGINS=*
